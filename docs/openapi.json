{
  "openapi": "3.1.0",
  "info": {
    "title": "BlindSpot AI Service",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/imports": {
      "post": {
        "summary": "Extract Documents",
        "operationId": "extract_documents_v1_imports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/environments/verify": {
      "post": {
        "summary": "Verify Login",
        "operationId": "verify_login_v1_environments_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/jobs/{job_id}/evidence/{evidence_id}": {
      "get": {
        "summary": "Retrieve Evidence",
        "operationId": "retrieve_evidence_v1_jobs__job_id__evidence__evidence_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "evidence_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Evidence Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs": {
      "post": {
        "summary": "Submit Job",
        "operationId": "submit_job_v1_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobEnvelope"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Submit Job V1 Jobs Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "post": {
        "summary": "Cancel Job",
        "operationId": "cancel_job_v1_jobs__job_id__cancel_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Cancel Job V1 Jobs  Job Id  Cancel Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CriterionSpec": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "CriterionSpec"
      },
      "DocumentInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "brd",
              "srs",
              "design_spec"
            ],
            "title": "Role"
          },
          "filename": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Filename"
          },
          "content_type": {
            "type": "string",
            "maxLength": 150,
            "title": "Content Type"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 14000000,
            "minLength": 1,
            "title": "Content Base64"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "role",
          "filename",
          "content_type",
          "content_base64"
        ],
        "title": "DocumentInput"
      },
      "EvidenceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "type": {
            "type": "string",
            "enum": [
              "screenshot",
              "page_text",
              "log"
            ],
            "title": "Type"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "content_base64": {
            "type": "string",
            "maxLength": 14000000,
            "title": "Content Base64"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          },
          "captured_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Captured At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "job_id",
          "type",
          "media_type",
          "content_base64",
          "sha256"
        ],
        "title": "EvidenceResponse"
      },
      "ExtractedRequirement": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "title": "Description"
          },
          "category": {
            "type": "string",
            "enum": [
              "functional",
              "ux",
              "data",
              "performance",
              "security"
            ],
            "title": "Category",
            "default": "functional"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "title": "Priority",
            "default": "medium"
          },
          "criteria": {
            "items": {
              "type": "string",
              "maxLength": 2000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Criteria"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "excerpt": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Excerpt"
          },
          "char_start": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Char Start"
          },
          "char_end": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Char End"
          },
          "clarification_reason": {
            "type": "string",
            "maxLength": 2000,
            "title": "Clarification Reason",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "description",
          "criteria",
          "document_id",
          "excerpt",
          "char_start",
          "char_end"
        ],
        "title": "ExtractedRequirement"
      },
      "ExtractionRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Request Id"
          },
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentInput"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 2,
            "title": "Documents"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "documents"
        ],
        "title": "ExtractionRequest"
      },
      "ExtractionResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/ExtractedRequirement"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Requirements"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "requirements"
        ],
        "title": "ExtractionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobEnvelope": {
        "properties": {
          "job_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Job Id"
          },
          "run_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Run Id"
          },
          "engine": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "mvp",
                  "graph",
                  "stub"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine"
          },
          "target_url": {
            "type": "string",
            "title": "Target Url"
          },
          "viewport_width": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Viewport Width",
            "default": 1920
          },
          "viewport_height": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Viewport Height",
            "default": 1080
          },
          "credentials": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Credentials"
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/RequirementSpec"
            },
            "type": "array",
            "minItems": 1,
            "title": "Requirements"
          },
          "callback_base_url": {
            "type": "string",
            "title": "Callback Base Url"
          },
          "callback_token": {
            "type": "string",
            "minLength": 1,
            "title": "Callback Token"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "run_id",
          "target_url",
          "requirements",
          "callback_base_url",
          "callback_token"
        ],
        "title": "JobEnvelope"
      },
      "RequirementSpec": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "criteria": {
            "items": {
              "$ref": "#/components/schemas/CriterionSpec"
            },
            "type": "array",
            "minItems": 1,
            "title": "Criteria"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "criteria"
        ],
        "title": "RequirementSpec"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationRequest": {
        "properties": {
          "request_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Request Id"
          },
          "environment_id": {
            "type": "string",
            "title": "Environment Id"
          },
          "revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Revision"
          },
          "target_url": {
            "type": "string",
            "title": "Target Url"
          },
          "credentials": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Credentials"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "environment_id",
          "revision",
          "target_url"
        ],
        "title": "VerificationRequest"
      },
      "VerificationResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "environment_id": {
            "type": "string",
            "title": "Environment Id"
          },
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "rejected",
              "inconclusive"
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "enum": [
              "success_observed",
              "login_failed",
              "success_condition_missing",
              "target_blocked",
              "browser_error"
            ],
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "environment_id",
          "revision",
          "status",
          "reason"
        ],
        "title": "VerificationResponse"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
