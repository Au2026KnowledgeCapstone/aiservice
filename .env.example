# Selects which verification engine runs. One of: mvp, graph, stub.
# Unknown values fail at startup. `graph` is reserved until its engine lands.
ENGINE=mvp

# aiservice's own operational database (job/outbox bookkeeping). Required —
# this is NOT BlindSpotBE's database.
DATABASE_URL=postgresql+psycopg2://aiservice:aiservice@localhost:5432/aiservice

# Shared secret BE presents on POST /v1/jobs.
SERVICE_TOKEN=

# How many jobs this process runs at once.
MAX_CONCURRENT_JOBS=1

# Per-job wall-clock timeout, in seconds.
JOB_TIMEOUT_SECONDS=1800
