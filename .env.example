# Selects which verification engine runs. One of: mvp, graph, stub.
# Unknown values fail at startup. `graph` is reserved until its engine lands.
ENGINE=mvp

# aiservice's own operational database (job/outbox bookkeeping). Required —
# this is NOT BlindSpotBE's database.
DATABASE_URL=postgresql+psycopg2://aiservice:aiservice@localhost:5432/aiservice

# Shared secret BE presents on POST /v1/jobs.
SERVICE_TOKEN=

# How many jobs this process runs at once.
MAX_CONCURRENT_JOBS=1

# Per-job wall-clock timeout, in seconds.
JOB_TIMEOUT_SECONDS=1800

# MVP planning and browser evidence assessment (OpenAI Chat Completions API).
# Without AI_API_KEY, provider calls remain disabled and MVP outcomes are inconclusive.
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=90

# Dedicated Fernet key recommended; if blank, derived from SERVICE_TOKEN.
# Keep stable across restarts; rotate only after draining pending callbacks.
CALLBACK_ENCRYPTION_KEY=
CALLBACK_POLL_SECONDS=1
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_LEASE_SECONDS=30
CALLBACK_BACKOFF_SECONDS=1
CALLBACK_BACKOFF_MAX_SECONDS=300

# Document extraction; no real model request occurs until configured and invoked.
EXTRACTION_API_URL=https://api.openai.com/v1
EXTRACTION_API_KEY=
EXTRACTION_MODEL=
EXTRACTION_TIMEOUT_SECONDS=80
# Browser capability is separate from A1 jobs. Install .[engine] and Chromium first.
VERIFICATION_ENABLED=false
VERIFICATION_TIMEOUT_SECONDS=30
# Explicit development hosts only; metadata endpoints are always blocked.
VERIFICATION_ALLOWED_PRIVATE_HOSTS=
# Optional system Chrome/Chromium executable. Blank uses Playwright Chromium.
VERIFICATION_BROWSER_EXECUTABLE=
